  "scripts": {
    "-prebuild": "rimraf dist && pnpm run generate",
    "api": "pnpm swagger-to-graphql --swagger-schema=./api-docs.json > api.schema.graphql",
    "build": "nest build",
    "compose:down": "docker-compose down --volumes",
    "compose:up": "docker-compose up -d",
    "crud": "pnpm nest g resource",
    "db:clean": "ts-node scripts/clean.ts",
    "db:init": "run-s \"db:migrate-save -- --name 'initial version'\" db:migrate-up seed",
    "db:migrate-save": "prisma migrate dev",
    "db:migrate-up": "prisma migrate deploy",
    "dev": "NODE_OPTIONS='--experimental-require-module' nest start --watch -e 'node --experimental-require-module'",
    "docker:build": "docker build .",
    "docker:db": "docker-compose -f docker-compose.db.yml up -d",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "generate": "prisma generate --schema=../../prisma/prisma/schema.prisma --generator client",
    "generate:database": "prisma migrate dev --name init --schema=../../prisma/prisma/schema.prisma",
    "i": "pnpm --only=prod",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "nest": "nest",
    "prettier": "prettier --write --cache .",
    "prettier-diff": "git diff --name-only | grep '^clients/web/' | sed 's|^clients/web/||' | xargs prettier --write",
    "pull": "prisma db pull --schema=../../prisma/prisma/schema.prisma",
    "push": "prisma db push --schema=../../prisma/prisma/schema.prisma",
    "seed": "prisma db seed --schema=../../prisma/prisma/schema.prisma",
    "start": "nest start -e 'node --experimental-require-module'",
    "start:debug": "nest start --debug --watch -e 'node --experimental-require-module'",
    "start:prod": "NODE_ENV=production node dist/src/main",
    "studio": "prisma studio --schema=../../prisma/prisma/schema.prisma"
  },
